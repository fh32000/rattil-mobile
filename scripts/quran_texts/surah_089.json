{
  "number": 89,
  "name": "سُورَةُ الفَجۡرِ",
  "englishName": "Al-Fajr",
  "englishNameTranslation": "The Dawn",
  "revelationType": "Meccan",
  "numberOfAyahs": 30,
  "ayahs": [
    {
      "number": 5994,
      "text": "بسم الله الرحمن الرحيم والفجر",
      "numberInSurah": 1,
      "juz": 30,
      "manzil": 7,
      "page": 593,
      "ruku": 531,
      "hizbQuarter": 237,
      "sajda": false
    },
    {
      "number": 5995,
      "text": "وليال عشر",
      "numberInSurah": 2,
      "juz": 30,
      "manzil": 7,
      "page": 593,
      "ruku": 531,
      "hizbQuarter": 237,
      "sajda": false
    },
    {
      "number": 5996,
      "text": "والشفع والوتر",
      "numberInSurah": 3,
      "juz": 30,
      "manzil": 7,
      "page": 593,
      "ruku": 531,
      "hizbQuarter": 237,
      "sajda": false
    },
    {
      "number": 5997,
      "text": "والليل إذا يسر",
      "numberInSurah": 4,
      "juz": 30,
      "manzil": 7,
      "page": 593,
      "ruku": 531,
      "hizbQuarter": 237,
      "sajda": false
    },
    {
      "number": 5998,
      "text": "هل في ذلك قسم لذي حجر",
      "numberInSurah": 5,
      "juz": 30,
      "manzil": 7,
      "page": 593,
      "ruku": 531,
      "hizbQuarter": 237,
      "sajda": false
    },
    {
      "number": 5999,
      "text": "ألم تر كيف فعل ربك بعاد",
      "numberInSurah": 6,
      "juz": 30,
      "manzil": 7,
      "page": 593,
      "ruku": 531,
      "hizbQuarter": 237,
      "sajda": false
    },
    {
      "number": 6000,
      "text": "إرم ذات العماد",
      "numberInSurah": 7,
      "juz": 30,
      "manzil": 7,
      "page": 593,
      "ruku": 531,
      "hizbQuarter": 237,
      "sajda": false
    },
    {
      "number": 6001,
      "text": "التي لم يخلق مثلها في البلاد",
      "numberInSurah": 8,
      "juz": 30,
      "manzil": 7,
      "page": 593,
      "ruku": 531,
      "hizbQuarter": 237,
      "sajda": false
    },
    {
      "number": 6002,
      "text": "وثمود الذين جابوا الصخر بالواد",
      "numberInSurah": 9,
      "juz": 30,
      "manzil": 7,
      "page": 593,
      "ruku": 531,
      "hizbQuarter": 237,
      "sajda": false
    },
    {
      "number": 6003,
      "text": "وفرعون ذي الأوتاد",
      "numberInSurah": 10,
      "juz": 30,
      "manzil": 7,
      "page": 593,
      "ruku": 531,
      "hizbQuarter": 237,
      "sajda": false
    },
    {
      "number": 6004,
      "text": "الذين طغوا في البلاد",
      "numberInSurah": 11,
      "juz": 30,
      "manzil": 7,
      "page": 593,
      "ruku": 531,
      "hizbQuarter": 237,
      "sajda": false
    },
    {
      "number": 6005,
      "text": "فأكثروا فيها الفساد",
      "numberInSurah": 12,
      "juz": 30,
      "manzil": 7,
      "page": 593,
      "ruku": 531,
      "hizbQuarter": 237,
      "sajda": false
    },
    {
      "number": 6006,
      "text": "فصب عليهم ربك سوط عذاب",
      "numberInSurah": 13,
      "juz": 30,
      "manzil": 7,
      "page": 593,
      "ruku": 531,
      "hizbQuarter": 237,
      "sajda": false
    },
    {
      "number": 6007,
      "text": "إن ربك لبالمرصاد",
      "numberInSurah": 14,
      "juz": 30,
      "manzil": 7,
      "page": 593,
      "ruku": 531,
      "hizbQuarter": 237,
      "sajda": false
    },
    {
      "number": 6008,
      "text": "فأما الإنسان إذا ما ابتلاه ربه فأكرمه ونعمه فيقول ربي أكرمن",
      "numberInSurah": 15,
      "juz": 30,
      "manzil": 7,
      "page": 593,
      "ruku": 531,
      "hizbQuarter": 237,
      "sajda": false
    },
    {
      "number": 6009,
      "text": "وأما إذا ما ابتلاه فقدر عليه رزقه فيقول ربي أهانن",
      "numberInSurah": 16,
      "juz": 30,
      "manzil": 7,
      "page": 593,
      "ruku": 531,
      "hizbQuarter": 237,
      "sajda": false
    },
    {
      "number": 6010,
      "text": "كلا ۖ بل لا تكرمون اليتيم",
      "numberInSurah": 17,
      "juz": 30,
      "manzil": 7,
      "page": 593,
      "ruku": 531,
      "hizbQuarter": 237,
      "sajda": false
    },
    {
      "number": 6011,
      "text": "ولا تحاضون على طعام المسكين",
      "numberInSurah": 18,
      "juz": 30,
      "manzil": 7,
      "page": 593,
      "ruku": 531,
      "hizbQuarter": 237,
      "sajda": false
    },
    {
      "number": 6012,
      "text": "وتأكلون التراث أكلا لما",
      "numberInSurah": 19,
      "juz": 30,
      "manzil": 7,
      "page": 593,
      "ruku": 531,
      "hizbQuarter": 237,
      "sajda": false
    },
    {
      "number": 6013,
      "text": "وتحبون المال حبا جما",
      "numberInSurah": 20,
      "juz": 30,
      "manzil": 7,
      "page": 593,
      "ruku": 531,
      "hizbQuarter": 237,
      "sajda": false
    },
    {
      "number": 6014,
      "text": "كلا إذا دكت الأرض دكا دكا",
      "numberInSurah": 21,
      "juz": 30,
      "manzil": 7,
      "page": 593,
      "ruku": 531,
      "hizbQuarter": 237,
      "sajda": false
    },
    {
      "number": 6015,
      "text": "وجاء ربك والملك صفا صفا",
      "numberInSurah": 22,
      "juz": 30,
      "manzil": 7,
      "page": 593,
      "ruku": 531,
      "hizbQuarter": 237,
      "sajda": false
    },
    {
      "number": 6016,
      "text": "وجيء يومئذ بجهنم ۚ يومئذ يتذكر الإنسان وأنى له الذكرى",
      "numberInSurah": 23,
      "juz": 30,
      "manzil": 7,
      "page": 593,
      "ruku": 531,
      "hizbQuarter": 237,
      "sajda": false
    },
    {
      "number": 6017,
      "text": "يقول يا ليتني قدمت لحياتي",
      "numberInSurah": 24,
      "juz": 30,
      "manzil": 7,
      "page": 594,
      "ruku": 531,
      "hizbQuarter": 237,
      "sajda": false
    },
    {
      "number": 6018,
      "text": "فيومئذ لا يعذب عذابه أحد",
      "numberInSurah": 25,
      "juz": 30,
      "manzil": 7,
      "page": 594,
      "ruku": 531,
      "hizbQuarter": 237,
      "sajda": false
    },
    {
      "number": 6019,
      "text": "ولا يوثق وثاقه أحد",
      "numberInSurah": 26,
      "juz": 30,
      "manzil": 7,
      "page": 594,
      "ruku": 531,
      "hizbQuarter": 237,
      "sajda": false
    },
    {
      "number": 6020,
      "text": "يا أيتها النفس المطمئنة",
      "numberInSurah": 27,
      "juz": 30,
      "manzil": 7,
      "page": 594,
      "ruku": 531,
      "hizbQuarter": 237,
      "sajda": false
    },
    {
      "number": 6021,
      "text": "ارجعي إلى ربك راضية مرضية",
      "numberInSurah": 28,
      "juz": 30,
      "manzil": 7,
      "page": 594,
      "ruku": 531,
      "hizbQuarter": 237,
      "sajda": false
    },
    {
      "number": 6022,
      "text": "فادخلي في عبادي",
      "numberInSurah": 29,
      "juz": 30,
      "manzil": 7,
      "page": 594,
      "ruku": 531,
      "hizbQuarter": 237,
      "sajda": false
    },
    {
      "number": 6023,
      "text": "وادخلي جنتي",
      "numberInSurah": 30,
      "juz": 30,
      "manzil": 7,
      "page": 594,
      "ruku": 531,
      "hizbQuarter": 237,
      "sajda": false
    }
  ],
