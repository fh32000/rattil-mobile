      "juz": 30,
      "manzil": 7,
      "page": 592,
      "ruku": 530,
      "hizbQuarter": 237,
      "sajda": false
    },
    {
      "number": 5974,
      "text": "لا يسمن ولا يغني من جوع",
      "numberInSurah": 7,
      "juz": 30,
      "manzil": 7,
      "page": 592,
      "ruku": 530,
      "hizbQuarter": 237,
      "sajda": false
    },
    {
      "number": 5975,
      "text": "وجوه يومئذ ناعمة",
