  "numberOfAyahs": 26,
  "ayahs": [
    {
      "number": 5968,
      "text": "بسم الله الرحمن الرحيم هل أتاك حديث الغاشية",
      "numberInSurah": 1,
      "juz": 30,
      "manzil": 7,
      "page": 592,
      "ruku": 530,
      "hizbQuarter": 237,
      "sajda": false
    },
    {
      "number": 5969,
      "text": "وجوه يومئذ خاشعة",
      "numberInSurah": 2,
      "juz": 30,
      "manzil": 7,
      "page": 592,
      "ruku": 530,
      "hizbQuarter": 237,
      "sajda": false
    },
    {
      "number": 5970,
      "text": "عاملة ناصبة",
      "numberInSurah": 3,
      "juz": 30,
      "manzil": 7,
      "page": 592,
      "ruku": 530,
      "hizbQuarter": 237,
      "sajda": false
    },
    {
      "number": 5971,
      "text": "تصلى نارا حامية",
      "numberInSurah": 4,
      "juz": 30,
      "manzil": 7,
      "page": 592,
      "ruku": 530,
      "hizbQuarter": 237,
      "sajda": false
    },
    {
      "number": 5972,
      "text": "تسقى من عين آنية",
      "numberInSurah": 5,
      "juz": 30,
      "manzil": 7,
      "page": 592,
      "ruku": 530,
      "hizbQuarter": 237,
      "sajda": false
    },
    {
      "number": 5973,
      "text": "ليس لهم طعام إلا من ضريع",
